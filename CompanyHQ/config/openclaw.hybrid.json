    },
    {
      "taskType": "gameplay",
      "provider": "ollama",
      "model": "llama3.1"
    }
  ],
  "providers": {
    "openai-codex": "OPENAI_API_KEY",
    "openrouter": "OPENROUTER_API_KEY",
    "ollama": "OLLAMA_BASE_URL"
  }
}
